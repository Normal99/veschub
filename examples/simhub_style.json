  "name": "SimHub-Style Feature Showcase",
  "description": "Comprehensive dashboard demonstrating all VescHub features including conditional formatting, animations, multiple widget types, and advanced layouts",
  "author": "VescHub Team",
  "defaultScreen": "home",
  "theme": {
    "name": "Premium Dark",
    "defaultFontFamily": "Roboto",
    "defaultFontSize": 14,
    "defaultColor": "#E0E0E0",
    "defaultBackgroundColor": "#121212",
    "accentColor": "#1E88E5",
    "warningColor": "#FFC107",
    "dangerColor": "#F44336"
