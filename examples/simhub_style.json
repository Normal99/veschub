            {
              "condition": "battery_percent < 20",
              "properties": {
                "tintColor": "#F44336"
              }
            },
            {
              "condition": "battery_percent >= 20 && battery_percent < 50",
              "properties": {
                "tintColor": "#FFC107"
              }
            },
            {
              "condition": "battery_percent >= 50",
              "properties": {
                "tintColor": "#4CAF50"
